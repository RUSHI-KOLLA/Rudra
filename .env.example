# ── VG Mini CID Investigator — environment ──────────────────────────────────
# Every key below is OPTIONAL. With no keys at all the investigator still
# works: Google News RSS + GDELT + Wikidata + EDGAR + GLEIF are keyless, and
# the synthesis falls back to a deterministic mechanical summary.

# ── Access ──────────────────────────────────────────────────────────────────
# Deployment access key. Set it to lock the endpoint down: every request must
# present it in X-VG-Access-Key (401 otherwise), and only authorized requests
# may use the server's GROQ_API_KEY. Leave it unset for an open, rate-limited
# endpoint — in that mode the server's Groq quota is never spent.
VG_ACCESS_KEY=

# Investigations allowed per minute per client address (0 = unlimited).
VG_RATE_LIMIT_PER_MINUTE=10

# Rejected access keys allowed per minute per client address. Kept
# separate so a flood of wrong keys cannot lock out the real users.
VG_AUTH_ATTEMPT_LIMIT_PER_MINUTE=30

# Longest accepted question, in characters.
VG_MAX_QUESTION_CHARS=500

# Largest accepted request body, in bytes.
VG_MAX_BODY_BYTES=65536

# Wall-clock ceiling for one investigation.
VG_MAX_INVESTIGATION_SECONDS=60

# Origins allowed to call the API cross-origin, comma separated. The bundled
# browser UI is same-origin and needs nothing here. There is no wildcard —
# list the origins one by one.
VG_ALLOWED_ORIGINS=

# Set to 1 only when the service sits behind a proxy that overwrites
# X-Forwarded-For (Render, Koyeb). It is how the rate limiter tells clients
# apart instead of seeing one shared proxy address.
VG_TRUST_PROXY=0

# ── LLM synthesis (one bounded call per investigation) ──────────────────────
# Without a key the investigator returns its deterministic mechanical summary.
# A caller may also pass their own key per request in X-API-Key (BYOK).
GROQ_API_KEY=
GROQ_MODEL_LARGE=openai/gpt-oss-120b
VG_TEMPERATURE=0.2
VG_MAX_TOKENS=1500

# Server binding (used by Procfile / Render / Koyeb)
# PORT=8080
# VG_HOST=0.0.0.0

# ── Optional news/search sources ────────────────────────────────────────────
# Brave Search: optional, but signup requires a credit card.
BRAVE_API_KEY=
# OpenSanctions: optional, deep sanctions/PEP coverage when a key is present.
OPENSANCTIONS_API_KEY=
# Google News RSS is always on. GDELT is on by default; set 0 to disable.
ENABLE_GDELT=1
# DuckDuckGo fallback is off by default (rate limits/timeouts); set 1 to enable.
ENABLE_DDGS=0

# SEC requires a real contact in the User-Agent. Give it one.
SEC_USER_AGENT=VG-Investigator/1.0 (you@example.com)
