# ── VG Mini CID Investigator — environment ──────────────────────────────────
# Every key below is OPTIONAL. With no keys at all the investigator still
# works: Google News RSS + GDELT + Wikidata + EDGAR + GLEIF are keyless.

# LLM synthesis (one bounded call per investigation). Without it the
# investigator returns its deterministic mechanical summary.
GROQ_API_KEY=
GROQ_MODEL_LARGE=openai/gpt-oss-120b
VG_TEMPERATURE=0.2
VG_MAX_TOKENS=1500

# Server binding (used by Procfile / Render / Koyeb)
# PORT=8080
# VG_HOST=0.0.0.0

# ── Optional news/search sources ────────────────────────────────────────────
# Brave Search: optional, but signup requires a credit card.
BRAVE_API_KEY=
# OpenSanctions: optional, deep sanctions/PEP coverage when a key is present.
OPENSANCTIONS_API_KEY=
# Google News RSS is always on. GDELT is on by default; set 0 to disable.
ENABLE_GDELT=1
# DuckDuckGo fallback is off by default (rate limits/timeouts); set 1 to enable.
ENABLE_DDGS=0
